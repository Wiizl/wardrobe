<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Wardrobe.Controls"
             x:Class="Wardrobe.Pages.MainPage"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeader x:Name="Header"
                             Title="My Wardrobe" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,120" Spacing="18">

                <controls:ChipGroup x:Name="WardrobeChips"
                                    SelectionChanged="OnWardrobeChanged" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="WardrobeName"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                            <Label x:Name="WardrobeInfo"
                                   Grid.Column="1"
                                   Style="{StaticResource SecondaryLabel}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <controls:WardrobeLayoutView x:Name="LayoutView"
                                                     ShelfTapped="OnShelfTapped" />

                        <Label Text="Tap a shelf to see what's on it"
                               Style="{StaticResource SecondaryLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating "Add item" button -->
        <Border x:Name="AddButton"
                Grid.Row="1"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20,0,20,28"
                Padding="20,0,24,0"
                HeightRequest="56"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                SemanticProperties.Description="Add item">
            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,6" Radius="18" Opacity="1" />
            </Border.Shadow>
            <HorizontalStackLayout x:Name="AddButtonContent" Spacing="8" VerticalOptions="Center" />
        </Border>

        <controls:BottomSheet x:Name="Sheet" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
